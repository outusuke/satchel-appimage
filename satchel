OS_RELEASE = "/etc/os-release"


def install_hint(pkg):
    """The command that installs pkg on this distribution, guessed from /etc/os-release (dnf when unknown)."""
    ids = []
    try:
        with open(OS_RELEASE) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k in ("ID", "ID_LIKE"): ids += v.strip().strip('"').lower().split()
    except OSError: pass
    for i in ids:
        if i in ("debian", "ubuntu"): return f"sudo apt install {pkg}"
        if i in ("arch", "manjaro"): return f"sudo pacman -S {pkg}"
        if i in ("suse", "sles") or i.startswith("opensuse"): return f"sudo zypper install {pkg}"
    return f"sudo dnf install {pkg}"


def clean(n):
    """A safe file name: letters, digits, dot, dash, underscore. Accents are dropped (Café -> Cafe). A name with no usable
    letters at all (日本語, ...) becomes app-<short hash of the name>, so different names do not end up as the same file."""
    plain = "".join(c for c in unicodedata.normalize("NFKD", n) if not unicodedata.combining(c))
    out = re.sub(r"[^A-Za-z0-9._-]", "_", plain).lstrip("._-")[:64]
    if out.strip("_"): return out
    return "app-" + hashlib.sha1(n.encode("utf-8", "replace")).hexdigest()[:6] if n.strip(". _-") else "app"


def desktop_text(v):
    """A value for a .desktop file: a backslash is the escape character there, so it is doubled."""
    return v.replace("\\", "\\\\")


def default_name(path):
    """The app name suggested for a program: a file's name without its extension, a folder's name as it is."""
    p = path.rstrip("/") or path
    return os.path.basename(p) if os.path.isdir(p) else os.path.splitext(os.path.basename(p))[0]


def auto_name(current, previous, new):
    """What the Name box should say after the program changed. The new suggestion goes in when the box is empty or still
    shows the last suggestion; text the person typed or edited is kept."""
    return new if not current.strip() or current == previous else current


BIG_FOLDER = 1 << 30


def folder_size(folder, limit=None):
    """The total size in bytes of the files in a folder (links not followed); stops counting once it passes limit."""
    total = 0
    for root, _dirs, files in os.walk(folder):
        for f in files:
            try: total += os.lstat(os.path.join(root, f)).st_size
            except OSError: pass
            if limit and total > limit: return total
    return total


def outside_link(path, base):
    """True when path is a symbolic link that would not work once the folder is packed: an absolute link, or one that
    leads out of base (a folder, already resolved)."""
    if not os.path.islink(path): return False
    if os.path.isabs(os.readlink(path)): return True
    real = os.path.realpath(path)
    return not (real == base or real.startswith(base + os.sep))


def outside_links(folder):
    """Paths (relative to folder, sorted) of the symbolic links in it that point outside it or use an absolute path."""
    base, out = os.path.realpath(folder), []
    for root, dirs, files in os.walk(base):
        for n in dirs + files:
            p = os.path.join(root, n)
            if outside_link(p, base): out.append(os.path.relpath(p, base))
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
    return sorted(out)


def nested_problem(path):
    """Why a program that is itself an AppImage is refused, or ''. Inside another AppImage it needs FUSE to start, and a system
    that hands AppImages to a launcher or sandbox (binfmt_misc, ajail, AppImageLauncher) starts that instead of the program."""
    if not os.path.isfile(path) or appimage_offset(path) is None: return ""
    return (f"'{os.path.basename(path)}' is already an AppImage, so it is not packed inside another one: it would need FUSE to "
            "start, and a system that passes AppImages to a launcher or sandbox (binfmt_misc, ajail, AppImageLauncher) would "
            "start that instead. Use the file as it is, or unpack it and pack what is inside.")


def is_program(path):
    """True when the file starts like something that can be run: an ELF binary or a script with a #! line. The permission bit
    is not used: some packages mark every file executable, pictures and data included, and a copy or an extraction can drop
    the bit from a real program (the build sets it on the program it packs)."""
    try:
        with open(path, "rb") as f: head = f.read(4)
    except OSError:
        return False
    return head == b"\x7fELF" or head[:2] == b"#!"


def find_executables(folder):
    """Programs at most two folders deep, as paths relative to folder (shallowest first): ELF files and #! scripts,
    no .so files, no links that lead outside the folder."""
    base, out = os.path.realpath(folder), []
    for root, dirs, files in os.walk(base):
        if root[len(base):].count(os.sep) >= 2: dirs[:] = []
        for f in files:
            p = os.path.join(root, f)
            if outside_link(p, base): continue
            if os.path.isfile(p) and not (f.endswith(".so") or ".so." in f) and is_program(p):
                out.append(os.path.relpath(p, base))
    return sorted(out, key=lambda r: (r.count(os.sep), r))


def best_exe(exes, hints):
    """The index in exes of the program most likely meant: one named like a hint (the folder or app name) beats one whose
    name starts with a hint; otherwise the first. exes is the list from find_executables (shallowest first)."""
    want = [h.lower() for h in hints if h]
    best, score = 0, 0
    for i, e in enumerate(exes):
        stem = os.path.splitext(os.path.basename(e))[0].lower()
        s = 2 if stem in want else 1 if any(stem.startswith(h) for h in want) else 0
        if s > score: best, score = i, s
    return best


def _is_lib(name):
    return name.endswith(".so") or ".so." in name


def library_dirs(folder, max_depth=3):
    """Folders inside the program folder (at most three deep) that hold shared libraries, as paths relative to it
    ('.' is the folder itself), shallowest first. Names with a colon are skipped: they cannot go into LD_LIBRARY_PATH."""
    base, out = os.path.realpath(folder), []
    for root, dirs, files in os.walk(base):
        rel = os.path.relpath(root, base)
        depth = 0 if rel == "." else rel.count(os.sep) + 1
        if depth >= max_depth: dirs[:] = []
        if ":" not in rel and any(_is_lib(f) for f in files): out.append((depth, rel))
    return [rel for _, rel in sorted(out)[:30]]


def appimage_offset(path):
    """Where the squashfs image starts inside a type 2 AppImage (right after its ELF section headers), or None if it isn't one."""
    try:
        with open(path, "rb") as f:
            h = f.read(64)
            if len(h) < 64 or h[:4] != b"\x7fELF" or h[8:11] != b"AI\x02": return None
            e = "<" if h[5] == 1 else ">"
            if h[4] == 2: shoff, = struct.unpack_from(e + "Q", h, 0x28); sz, num = struct.unpack_from(e + "HH", h, 0x3A)
            else: shoff, = struct.unpack_from(e + "I", h, 0x20); sz, num = struct.unpack_from(e + "HH", h, 0x2E)
            off = shoff + sz * num
            f.seek(off)
            return off if f.read(4) in (b"hsqs", b"sqsh") else None
    except (OSError, struct.error):
        return None


def elf_dynamic(path):
    """(shared libraries it asks for, folders from its RPATH/RUNPATH, machine number) for an ELF program, read straight
    from the file without running it. ([], [], None) for anything that is not ELF or cannot be read; the machine number
    is still given for a static program, which has no dynamic section."""
    try:
        with open(path, "rb") as f:
            h = f.read(64)
            if len(h) < 64 or h[:4] != b"\x7fELF" or h[4] not in (1, 2) or h[5] not in (1, 2): return [], [], None
            e, wide = ("<" if h[5] == 1 else ">"), h[4] == 2
            machine, = struct.unpack_from(e + "H", h, 0x12)
            none = ([], [], machine)
            if wide: phoff, = struct.unpack_from(e + "Q", h, 0x20); phsz, phnum = struct.unpack_from(e + "HH", h, 0x36)
            else: phoff, = struct.unpack_from(e + "I", h, 0x1C); phsz, phnum = struct.unpack_from(e + "HH", h, 0x2A)
            if not 0 < phnum <= 256 or phsz < 32: return none
            f.seek(phoff)
            raw = f.read(phsz * phnum)
            loads, dyn = [], None
            for i in range(phnum):
                if wide: kind, _fl, off, vaddr, _pa, size, _ms, _al = struct.unpack_from(e + "IIQQQQQQ", raw, i * phsz)
                else: kind, off, vaddr, _pa, size, _ms, _fl, _al = struct.unpack_from(e + "IIIIIIII", raw, i * phsz)
                if kind == 1: loads.append((vaddr, off, size))
                elif kind == 2: dyn = (off, size)
            if not dyn or dyn[1] > 1024 * 1024: return none
            f.seek(dyn[0])
            data, step = f.read(dyn[1]), (16 if wide else 8)
            names, paths, strtab = [], [], None
            for i in range(0, len(data) - step + 1, step):
                tag, val = struct.unpack_from(e + ("qQ" if wide else "iI"), data, i)
                if tag == 0: break
                if tag == 1: names.append(val)
                elif tag in (15, 29): paths.append(val)             # DT_RPATH, DT_RUNPATH
                elif tag == 5: strtab = val
            if strtab is None: return none
            base = next((off + strtab - vaddr for vaddr, off, size in loads if vaddr <= strtab < vaddr + size), None)
            if base is None: return none
            def text(n):
                f.seek(base + n)
                return f.read(1024).split(b"\0", 1)[0].decode("utf-8", "replace")
            return [text(n)[:256] for n in names], [d for n in paths for d in text(n).split(":") if d], machine
    except (OSError, struct.error):
        return [], [], None


def needed_libs(path):
    """The shared libraries an ELF program asks for (its DT_NEEDED entries). Empty for scripts, static programs, anything
    that is not ELF, or a file that cannot be read."""
    return elf_dynamic(path)[0]


MACHINES = {"x86_64": 62, "amd64": 62, "aarch64": 183, "arm64": 183, "i386": 3, "i486": 3, "i586": 3, "i686": 3,
            "armv7l": 40, "armv8l": 40, "riscv64": 243, "ppc64le": 21, "ppc64": 21, "s390x": 22, "loongarch64": 258}


MACHINE_NAMES = {62: "x86_64", 183: "aarch64", 3: "i686", 40: "arm", 243: "riscv64", 21: "ppc64", 22: "s390x", 258: "loongarch64"}


def arch_problem(path, arch=None):
    """A warning when path is an ELF program built for another kind of computer than this one, else ''. Scripts and
    anything it cannot read give ''. The AppImage runtime is always made for this machine, so such a program cannot run in it."""
    arch = arch or platform.machine()
    want, have = MACHINES.get(arch), elf_dynamic(path)[2]
    if not want or not have or have == want: return ""
    return (f"Heads up: '{os.path.basename(path)}' is a program for {MACHINE_NAMES.get(have, 'machine type %d' % have)} "
            f"computers, but this one is {arch}. The AppImage will not run on a {arch} computer.")


def system_libraries():
    """The names of the shared libraries this system has: from 'ldconfig -p' where that works, plus the usual folders."""
    names = set()
    ld = shutil.which("ldconfig") or next((p for p in ("/sbin/ldconfig", "/usr/sbin/ldconfig") if os.access(p, os.X_OK)), None)
    if ld:
        try:
            r = subprocess.run([ld, "-p"], capture_output=True, text=True, errors="replace", stdin=subprocess.DEVNULL, timeout=20)
            for line in r.stdout.splitlines():
                if "=>" in line and line.split("=>")[0].split(): names.add(line.split("=>")[0].split()[0])
        except (OSError, subprocess.TimeoutExpired): pass
    for d in ("/lib", "/lib64", "/usr/lib", "/usr/lib64", "/usr/local/lib", "/usr/local/lib64",
              *glob.glob("/lib/*-linux-*"), *glob.glob("/usr/lib/*-linux-*")):
        try: names.update(os.listdir(d))
        except OSError: pass
    return names


def missing_libraries(src, exe):
    """Sorted names of shared libraries that the program (and the .so files packed with it) ask for but that are neither
    inside the packed folder nor installed on this system. Folders named in a program's RPATH/RUNPATH count too: one
    inside the packed folder ($ORIGIN/..., which travels with the AppImage) or an absolute one on this system.
    Empty when there are none, or when it cannot tell."""
    src = os.path.realpath(src)
    scan, have, folder = [], set(), os.path.isdir(src)
    try:
        if os.path.isfile(src): scan = [src]
        elif folder:
            prog = os.path.realpath(os.path.join(src, exe or ""))
            if not exe or not prog.startswith(src + os.sep) or not os.path.isfile(prog): return []
            scan = [prog]
            for rel in library_dirs(src):
                d = os.path.join(src, rel)
                for f in sorted(os.listdir(d)):
                    have.add(f)
                    if _is_lib(f) and os.path.isfile(os.path.join(d, f)) and len(scan) < 300: scan.append(os.path.join(d, f))
        else: return []
        wanted, seen = set(), set()
        for p in scan:
            names, paths, _ = elf_dynamic(p)
            wanted.update(names)
            for raw in paths:
                origin = "$ORIGIN" in raw or "${ORIGIN}" in raw
                d = raw.replace("${ORIGIN}", "$ORIGIN").replace("$ORIGIN", os.path.dirname(p))
                if "$" in d or not os.path.isabs(d): continue            # $LIB, $PLATFORM and relative folders: cannot tell
                d = os.path.realpath(d)
                if origin and not (folder and (d == src or d.startswith(src + os.sep))): continue     # would not travel
                if d in seen or len(seen) >= 30: continue
                seen.add(d)
                try: have.update(os.listdir(d))
                except OSError: pass
        wanted -= have
    except OSError:
        return []
    return sorted(wanted - system_libraries()) if wanted else []


def icon_problem(path):
    """Why path cannot be used as an icon, or None. The file must really be a PNG or an SVG, whatever its name says."""
    ext = os.path.splitext(path)[1].lower()
    if ext not in ICON_EXT or not os.path.isfile(path): return "The icon must be an existing .png or .svg file."
    try:
        with open(path, "rb") as f: head = f.read(4096)
    except OSError as e: return f"Could not read the icon: {e}"
    if ext == ".png" and head[:4] != b"\x89PNG": return "That file is named .png but is not a PNG image."
    if ext == ".svg" and b"<svg" not in head.lower(): return "That file is named .svg but is not an SVG image."
    return None


def png_size(path):
    """(width, height) read from a PNG header, or None."""
    try:
        with open(path, "rb") as f: head = f.read(24)
    except OSError: return None
    if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR": return None
    return struct.unpack(">II", head[16:24])


GOOD_ICON_WORDS = ("icon", "logo", "default", "appicon")


BAD_ICON_WORDS = ("splash", "banner", "background", "screenshot", "wallpaper", "header", "thumb", "preview", "symbolic",
                  "sprite", "cursor", "tray", "mask")


GOOD_ICON_DIRS = ("icons", "icon", "hicolor", "pixmaps", "apps")


BAD_ICON_DIRS = ("images", "img", "doc", "docs", "help", "screenshots", "samples", "examples", "test", "tests")


def desktop_icon_names(folder, depth=4):
    """The Icon= values of the .desktop files inside folder (name or absolute path as written)."""
    base, out = os.path.realpath(folder), []
    for root, dirs, files in os.walk(base):
        if root[len(base):].count(os.sep) >= depth: dirs[:] = []
        for fn in files:
            if not fn.endswith(".desktop"): continue
            try:
                with open(os.path.join(root, fn), encoding="utf-8", errors="replace") as f: text = f.read(20000)
            except OSError: continue
            m = re.search(r"^Icon\s*=\s*(.+?)\s*$", text, re.M)
            if m: out.append(m.group(1))
    return out


def find_icon(folder, hints=(), min_px=48, depth=4, limit=3000, extra_names=()):
    """The most likely icon inside a program folder, or None. Every real .png/.svg (checked by content; a .png is at
    least min_px) is scored by clues: an Icon= line in a .desktop file in the folder is the strongest; a file name
    that matches the program (hints) or says icon/logo is good; splash, banner, screenshot and similar names are bad;
    an icons/ folder is good, images/ or docs/ is bad; a square image is better. Ties go to the larger image, and
    an .svg counts as the largest. Looks at most depth folders down and at most limit files."""
    base, cands, seen = os.path.realpath(folder), [], 0
    if not os.path.isdir(base): return None
    named = [*desktop_icon_names(base, depth), *extra_names]
    names = {os.path.splitext(os.path.basename(n))[0].lower() for n in named}
    paths = {os.path.realpath(n) for n in named if os.path.isabs(n)}
    hint_stems = {os.path.splitext(os.path.basename(h))[0].lower() for h in hints if h}
    for root, dirs, files in os.walk(base):
        parts = [x.lower() for x in root[len(base):].split(os.sep) if x]
        if len(parts) >= depth: dirs[:] = []
        dirs.sort()
        for fn in sorted(files):
            seen += 1
            if seen > limit: break
            path, (stem, ext) = os.path.join(root, fn), os.path.splitext(fn)
            low = stem.lower()
            if ext.lower() not in ICON_EXT or os.path.islink(path) or icon_problem(path): continue
            if ext.lower() == ".svg": size, square = 4096, True
            else:
                wh = png_size(path)
                if not wh or min(wh) < min_px: continue
                size, square = min(wh), wh[0] == wh[1]
            score = 0
            if os.path.realpath(path) in paths or low in names: score += 100
            if low in hint_stems or any(h and low.startswith(h) for h in hint_stems): score += 50
            if any(w in low for w in GOOD_ICON_WORDS): score += 20
            if any(w in low for w in BAD_ICON_WORDS): score -= 60
            if any(d in GOOD_ICON_DIRS for d in parts): score += 15
            if any(d in BAD_ICON_DIRS for d in parts): score -= 15
            if square: score += 10
            cands.append((score, size, -len(parts), path))
        if seen > limit: break
    return max(cands)[3] if cands else None


def size_note(src):
    """A warning when the program folder is very big, or ''. The folder is copied once into the app folder and again into the image."""
    if os.path.isdir(src) and folder_size(src, BIG_FOLDER) > BIG_FOLDER:
        return ("Heads up: the program folder is over 1 GB. Building copies it twice, so it needs plenty of free disk space "
                "and takes a while, and the AppImage will be big.")
    return ""


def links_note(links):
    """A warning about links that were left out of the AppImage, or '' when there are none."""
    if not links: return ""
    shown = ", ".join(links[:8]) + (f" and {len(links) - 8} more" if len(links) > 8 else "")
    return ("Heads up: these symbolic links point outside the program folder (or use an absolute path), so they were "
            "left out of the AppImage: " + shown + ". If the program needs them, copy the real files into the folder.")


def packing_notes(src, exe, bundle=False):
    """All the warnings for the result message (wrong kind of computer, missing libraries, links left out, very big
    folder), joined;
    '' when there are none."""
    prog = os.path.join(src, exe) if os.path.isdir(src) else src
    links = outside_links(src) if os.path.isdir(src) else []
    notes = (arch_problem(prog) if os.path.isfile(prog) else "", ("" if bundle else missing_note(missing_libraries(src, exe))), links_note(links),
             size_note(src))
    return "\n\n".join(n for n in notes if n)


def missing_note(missing):
    """A warning for the result message, or '' when nothing is missing."""
    if not missing: return ""
    shown = ", ".join(missing[:12]) + (f" and {len(missing) - 12} more" if len(missing) > 12 else "")
    return ("Heads up: these shared libraries were not found on this system or inside the packed folder: " + shown
            + ". The AppImage will only run where they exist.")


# ---- packages (.deb): unpacked into a folder, then handled like any program folder ----
ARCHIVE_EXT = (".tar.gz", ".tgz", ".tar.xz", ".txz", ".tar.bz2", ".tbz2", ".tar.zst", ".tzst", ".zip")


PKG_EXT = (".deb",) + ARCHIVE_EXT                  # a .pkg.tar.zst (Arch) is an archive that also holds a usr/ tree


MAX_UNPACKED = 8 << 30
MAX_ENTRIES = 500000                               # most files, folders and links an unpacked package or archive may hold
MAX_LINK = 4096                                    # longest symbolic link target read from a .zip


CATEGORY_MAP = {"Utility": "Utility", "TextEditor": "Utility", "Development": "Development", "IDE": "Development",
                "Graphics": "Graphics", "Network": "Network", "WebBrowser": "Network", "Email": "Network",
                "AudioVideo": "AudioVideo", "Audio": "AudioVideo", "Video": "AudioVideo", "Player": "AudioVideo",
                "Office": "Office", "Game": "Game", "Education": "Education", "Science": "Science",
                "System": "System", "Settings": "Settings"}


def is_package(path):
    """A .deb, an Arch package, a .tar.* archive or a .zip: something Satchel unpacks to find the program inside."""
    return os.path.isfile(path) and path.lower().endswith(PKG_EXT)


def package_hint(path):
    """The program name from a file name like firefox_159.0.1_amd64.deb, firefox-159.0.1.tar.xz or foo-1.2-1-x86_64.pkg.tar.zst."""
    n = os.path.basename(path)
    for ext in sorted(PKG_EXT, key=len, reverse=True):
        if n.lower().endswith(ext): n = n[:-len(ext)]; break
    n = re.sub(r"\.pkg$", "", n)
    n = n.split("_")[0]
    return re.sub(r"[-.]v?\d[\w.+~:-]*$", "", n) or n


def ar_members(f):
    """(name, data offset, size) of each member of an ar archive (a .deb is one)."""
    if f.read(8) != b"!<arch>\n": raise BuildError("That file is not a .deb package (it is not an ar archive).")
    while True:
        head = f.read(60)
        if len(head) < 60: return
        try: size = int(head[48:58])
        except ValueError: size = -1
        if head[58:60] != b"`\n" or size < 0: raise BuildError("The .deb package is damaged (bad archive header).")
        start = f.tell()
        yield head[:16].decode("ascii", "replace").strip().rstrip("/"), start, size
        f.seek(start + size + (size & 1))


def zstd_unpack(raw, out):
    """Decompress the zstd file raw into out (Python 3.14's own module, else the zstd program)."""
    try:
        from compression import zstd                                    # Python 3.14 and later
        with zstd.open(raw, "rb") as s_, open(out, "wb") as o: shutil.copyfileobj(s_, o)
        return out
    except ImportError: pass
    z = shutil.which("zstd")
    if not z: raise BuildError(f"zstd is needed to unpack this package: {install_hint('zstd')}")
    r = subprocess.run([z, "-d", "-q", "-f", "-o", out, raw], capture_output=True, text=True, errors="replace",
                       stdin=subprocess.DEVNULL, timeout=600)
    if r.returncode != 0: raise BuildError("Could not unpack the package:\n" + (r.stderr or r.stdout).strip()[-400:])
    return out


def _tar_ready(raw, name, work):
    """A tar file tarfile can open: gz, bz2 and xz are read directly, zstd is unpacked first."""
    kind = name[len("data.tar"):]
    if kind in ("", ".gz", ".bz2", ".xz"): return raw
    if kind != ".zst": raise BuildError(f"This package uses a compression Satchel does not know ({name}).")
    return zstd_unpack(raw, f"{work}/data.tar")


def drop_escaping_links(base):
    """Remove every symbolic link under base that does not lead to a place inside base. A link is checked when it is made,
    but a later link can change where an earlier one leads (a -> b/.. is fine until b becomes a link to the folder itself),
    so the whole tree is checked again once everything is unpacked, until nothing more is removed."""
    base = os.path.realpath(base)
    for _ in range(64):
        gone = 0
        for root, dirs, files in os.walk(base):
            for n in dirs + files:
                p = os.path.join(root, n)
                if outside_link(p, base): os.remove(p); gone += 1
            dirs[:] = [d for d in dirs if os.path.isdir(os.path.join(root, d)) and not os.path.islink(os.path.join(root, d))]
        if not gone: return
    raise BuildError("The package has too many symbolic links that lead into each other, so it was not unpacked.")


def extract_tar(tar_path, dest):
    """Unpack a tar into dest safely: nothing is written outside dest (no .., no writing through links), absolute
    links are rewritten to point inside dest and every link is checked again after unpacking, device files and the like
    are skipped, and the total size and the number of entries are limited."""
    base, total, count = os.path.realpath(dest), 0, 0
    inside = lambda p: p == base or p.startswith(base + os.sep)
    os.makedirs(base, exist_ok=True)
    try:
        with tarfile.open(tar_path, "r:*") as tar:
            for m in tar:
                count += 1
                if count > MAX_ENTRIES: raise BuildError(f"The package holds more than {MAX_ENTRIES:,} entries, so it was not unpacked.")
                parts = [x for x in m.name.split("/") if x not in ("", ".")]
                if not parts or ".." in parts: continue
                target = os.path.join(base, *parts)
                parent = os.path.dirname(target)
                if not inside(os.path.realpath(parent)): continue
                if m.isdir():
                    if os.path.islink(target): continue
                    os.makedirs(target, exist_ok=True); os.chmod(target, (m.mode & 0o777) | 0o700)
                    continue
                os.makedirs(parent, exist_ok=True)
                if m.isreg():
                    total += m.size
                    if total > MAX_UNPACKED: raise BuildError("The package is unpacked larger than 8 GB, so it was not unpacked.")
                    if os.path.lexists(target): os.remove(target)
                    with tar.extractfile(m) as src_, open(target, "wb") as out: shutil.copyfileobj(src_, out)
                    os.chmod(target, (m.mode & 0o777) | 0o600)
                elif m.issym():
                    link = m.linkname
                    if os.path.isabs(link): link = os.path.relpath(os.path.join(base, link.lstrip("/")), parent)
                    if not inside(os.path.realpath(os.path.join(parent, link))): continue
                    if os.path.lexists(target): os.remove(target)
                    os.symlink(link, target)
                elif m.islnk():
                    srcp = os.path.join(base, *[x for x in m.linkname.split("/") if x not in ("", ".")])
                    if inside(os.path.realpath(srcp)) and os.path.isfile(srcp):
                        if os.path.lexists(target): os.remove(target)
                        shutil.copy2(srcp, target)
        drop_escaping_links(base)
    except BuildError: raise
    except Exception as e: raise BuildError(f"Could not unpack the package: {e}")


def unpack_deb(path, dest):
    """Unpack a .deb (its data.tar.*) into dest, with Python's own tools (a .zst package also needs zstd)."""
    parent = os.path.dirname(os.path.abspath(dest))
    try:
        with open(path, "rb") as f:
            for name, off, size in ar_members(f):
                if name.startswith("data.tar"): break
            else: raise BuildError("There is no data.tar inside that file, so it is not a usable .deb package.")
            with tempfile.TemporaryDirectory(prefix="satchel-deb-", dir=parent) as work:
                raw = f"{work}/data"
                f.seek(off)
                with open(raw, "wb") as o:
                    left = size
                    while left > 0:
                        chunk = f.read(min(left, 1 << 20))
                        if not chunk: raise BuildError("The .deb package is cut short (damaged download?).")
                        o.write(chunk); left -= len(chunk)
                extract_tar(_tar_ready(raw, name, work), dest)
    except OSError as e: raise BuildError(f"Could not read the package: {e}")


def extract_zip(zip_path, dest):
    """Unpack a .zip into dest with the same safety rules as extract_tar (nothing outside dest, links kept only when
    they stay inside and are checked again after unpacking, size and number of entries limited). The program's
    executable bit is kept."""
    base, total = os.path.realpath(dest), 0
    inside = lambda p: p == base or p.startswith(base + os.sep)
    os.makedirs(base, exist_ok=True)
    try:
        with zipfile.ZipFile(zip_path) as zf:
            infos = zf.infolist()
            if len(infos) > MAX_ENTRIES: raise BuildError(f"The archive holds more than {MAX_ENTRIES:,} entries, so it was not unpacked.")
            for zi in infos:
                parts = [x for x in zi.filename.replace("\\", "/").split("/") if x not in ("", ".")]
                if not parts or ".." in parts: continue
                target = os.path.join(base, *parts); parent = os.path.dirname(target)
                if not inside(os.path.realpath(parent)): continue
                mode = (zi.external_attr >> 16) & 0o7777
                if zi.is_dir():
                    if not os.path.islink(target): os.makedirs(target, exist_ok=True); os.chmod(target, (mode & 0o777) | 0o700)
                    continue
                os.makedirs(parent, exist_ok=True)
                if stat.S_ISLNK(zi.external_attr >> 16):               # the file type bits are in mode's upper part, which & 0o7777 cut off
                    if zi.file_size > MAX_LINK: continue
                    link = zf.read(zi).decode("utf-8", "replace")
                    if os.path.isabs(link): link = os.path.relpath(os.path.join(base, link.lstrip("/")), parent)
                    if not inside(os.path.realpath(os.path.join(parent, link))): continue
                    if os.path.lexists(target): os.remove(target)
                    os.symlink(link, target)
                    continue
                if os.path.lexists(target): os.remove(target)
                with zf.open(zi) as src_, open(target, "wb") as out:
                    while True:
                        chunk = src_.read(1 << 20)
                        if not chunk: break
                        total += len(chunk)
                        if total > MAX_UNPACKED: raise BuildError("The archive is unpacked larger than 8 GB, so it was not unpacked.")
                        out.write(chunk)
                os.chmod(target, ((mode & 0o777) or 0o644) | 0o600)
        drop_escaping_links(base)
    except BuildError: raise
    except Exception as e: raise BuildError(f"Could not unpack the archive: {e}")


def single_folder(dest):
    """dest, or the one folder inside it when that is all it holds (firefox.tar.xz holds just firefox/)."""
    try: names = os.listdir(dest)
    except OSError: return dest
    if len(names) == 1:
        inner = os.path.join(dest, names[0])
        if os.path.isdir(inner) and not os.path.islink(inner): return inner
    return dest


def unpack_archive(path, dest):
    """Unpack a .zip or .tar.* into dest."""
    if path.lower().endswith(".zip"): return extract_zip(path, dest)
    with tempfile.TemporaryDirectory(prefix="satchel-tar-", dir=os.path.dirname(os.path.abspath(dest))) as work:
        raw = path
        if path.lower().endswith((".zst", ".tzst")): raw = zstd_unpack(path, f"{work}/archive.tar")
        extract_tar(raw, dest)


def unpack_package(path, dest):
    """Unpack a .deb, an Arch package, a .tar.* archive or a .zip into dest. Returns the folder to use as the program
    folder: dest itself, except that an ordinary archive holding a single folder gives that folder."""
    low = path.lower()
    if low.endswith(".deb"):
        unpack_deb(path, dest); return dest
    if not low.endswith(ARCHIVE_EXT): raise BuildError("Only .deb packages, .tar.* archives and .zip files can be opened.")
    try: unpack_archive(path, dest)
    except OSError as e: raise BuildError(f"Could not read the archive: {e}")
    return dest if ".pkg." in os.path.basename(low) else single_folder(dest)


def parse_desktop(path):
    """The keys of the [Desktop Entry] group of a .desktop file (first value of each, translations left out)."""
    out, inside = {}, False
    try:
        with open(path, encoding="utf-8", errors="replace") as f: text = f.read(50000)
    except OSError: return out
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["): inside = line == "[Desktop Entry]"
        elif inside and "=" in line and not line.startswith("#"):
            k, _, v = line.partition("=")
            if "[" not in k: out.setdefault(k.strip(), v.strip())
    return out


def package_info(root, hint=""):
    """What an unpacked package says about itself: its programs (usr/bin, usr/games, opt), the one to start, and the
    name, description, category, terminal flag and icon from its .desktop file. Missing things are '' or None."""
    root = os.path.realpath(root)
    every = find_executables(root)
    exes = [e for e in every if e.startswith(("usr/bin/", "usr/games/", "opt/"))] or every
    by_name = {os.path.basename(e): e for e in exes}
    entries, apps = [], os.path.join(root, "usr/share/applications")
    if os.path.isdir(apps):
        for fn in sorted(os.listdir(apps)):
            d = parse_desktop(os.path.join(apps, fn)) if fn.endswith(".desktop") else {}
            if d.get("Type", "Application") == "Application" and d.get("NoDisplay", "").lower() != "true": entries.append(d)
    def exec_name(d):
        words = [w for w in d.get("Exec", "").split() if w != "env" and "=" not in w]
        return os.path.basename(words[0]) if words else ""
    entry = next((d for d in entries if exec_name(d) in by_name), entries[0] if entries else {})
    exe = by_name.get(exec_name(entry)) or by_name.get(hint) or (exes[0] if exes else "")
    icon_name = entry.get("Icon", "")
    names = [icon_name] if icon_name else []
    hints = [os.path.basename(exe), hint, *names]
    icon = None
    for sub in ("usr/share/icons", "usr/share/pixmaps", "opt", ""):
        d = os.path.join(root, sub)
        if os.path.isdir(d): icon = find_icon(d, hints, depth=7, limit=20000, extra_names=names)
        if icon: break
    category = next((CATEGORY_MAP[c] for c in entry.get("Categories", "").split(";") if c in CATEGORY_MAP), "")
    return {"exes": exes, "exe": exe, "name": entry.get("Name", ""), "comment": entry.get("Comment", ""),
            "category": category, "terminal": entry.get("Terminal", "").lower() == "true", "icon": icon}


def need_bwrap():
    """The bubblewrap program, or a BuildError that says how to install it."""
    bwrap = shutil.which("bwrap")
    if not bwrap: raise BuildError(f"The sandbox is switched on but bubblewrap (bwrap) was not found: {install_hint('bubblewrap')}")
    return bwrap


def display_args(env):
    """(bubblewrap arguments, environment pairs) that let a program in the sandbox use your screen: the Wayland socket
    and/or the X11 socket with its login file, plus /dev/dri for graphics. Nothing else of your session is shown, and
    the network stays off. With no screen in env this adds nothing."""
    a, e = [], []
    run = env.get("XDG_RUNTIME_DIR", "")
    wl = env.get("WAYLAND_DISPLAY", "")
    if run and wl:
        sock = wl if os.path.isabs(wl) else os.path.join(run, wl)
        if os.path.exists(sock):
            a += ["--ro-bind", sock, f"/run/satchel-display/{os.path.basename(sock)}"]
            e += [("XDG_RUNTIME_DIR", "/run/satchel-display"), ("WAYLAND_DISPLAY", os.path.basename(sock))]
    disp = env.get("DISPLAY", "")
    if disp and os.path.isdir("/tmp/.X11-unix"):
        a += ["--ro-bind", "/tmp/.X11-unix", "/tmp/.X11-unix"]
        e.append(("DISPLAY", disp))
        xa = env.get("XAUTHORITY") or os.path.expanduser("~/.Xauthority")
        if os.path.isfile(xa):
            a += ["--ro-bind", os.path.realpath(xa), "/run/satchel-display/Xauthority"]
            e.append(("XAUTHORITY", "/run/satchel-display/Xauthority"))
    if e: a += ["--dev-bind-try", "/dev/dri", "/dev/dri"]
    return a, e


def bwrap_base(bwrap, show, work, arch, home, net, version="", display=False):
    """The bubblewrap part of a command, ending in '--': the system is read-only, your real home and other users are
    hidden, /tmp is fresh, and only the work folder is writable. Network only if net (it is needed to download the
    runtime when you have not set one). Files in show that lie inside your home are shown read-only. No system-call
    filter: this is a convenience sandbox, not a security boundary. With display, the screen is let through (see
    display_args) so a window program can open its window; the network stays off."""
    parent = os.path.dirname(home)
    a = [bwrap, "--unshare-all", *(["--share-net"] if net else []), "--die-with-parent", "--new-session", "--clearenv",
         "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp", "--tmpfs", "/run"]
    if net: a += [x for d in ("/run/systemd/resolve", "/run/NetworkManager") for x in ("--ro-bind-try", d, d)]   # DNS
    a += ["--tmpfs", parent] if parent != "/" else []
    a += ["--tmpfs", home]
    for d in ("/root", "/mnt", "/media", "/srv"):
        if os.path.isdir(d) and not os.path.islink(d) and home != d and not home.startswith(d + "/"): a += ["--tmpfs", d]
    for q in dict.fromkeys(os.path.realpath(x) for x in show if x):
        if q.startswith(home + "/"): a += ["--ro-bind", q, q]
    a += ["--bind", work, work]
    envs = []
    if display:
        more, envs = display_args(os.environ)
        a += more
    for k, v in (*envs, ("HOME", home), ("PATH", "/usr/local/bin:/usr/bin:/usr/sbin"), ("LANG", "C.UTF-8"), ("ARCH", arch),
                 *((("VERSION", version),) if version else ())):
        a += ["--setenv", k, v]
    return a + ["--chdir", work, "--"]


def bwrap_cmd(bwrap, exe, share, runtime, appdir, out, work, arch, home, net, version=""):
    """appimagetool inside bubblewrap (see bwrap_base). A tool or runtime file inside your home is shown read-only."""
    return (bwrap_base(bwrap, (share or exe, runtime), work, arch, home, net, version)
            + [exe, *(["--runtime-file", runtime] if runtime else []), appdir, out])


def run_streaming(cmd, env, cwd, log=None, cancel=None, timeout=600, timeout_is_error=True, own_group=True):
    """Run cmd and hand each line of its output (errors included) to log as it appears. The program is stopped when
    cancel is set (raises Cancelled), on Ctrl-C, or after timeout seconds (raises BuildError, or just returns when
    timeout_is_error is False). With own_group it runs in a process group of its own and the whole group is stopped;
    without it only cmd itself is stopped (bubblewrap cannot be a group leader because it starts its own session, and it
    takes everything inside it down with it). Returns (exit code or None, the last lines of output, timed out)."""
    if log: log("$ " + shlex.join(cmd))
    try: p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace", env=env,
                              cwd=cwd, stdin=subprocess.DEVNULL, start_new_session=own_group)
    except OSError as e: raise BuildError(f"Could not start {os.path.basename(cmd[0])}: {e}")
    tail = collections.deque(maxlen=200)

    def pump():
        for line in p.stdout:
            line = line.rstrip("\n"); tail.append(line)
            if log: log(line)
    reader = threading.Thread(target=pump, daemon=True); reader.start()

    def stop():
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try: os.killpg(p.pid, sig) if own_group else p.send_signal(sig)
            except OSError: break
            try: p.wait(timeout=3); break
            except subprocess.TimeoutExpired: pass
    why, deadline = None, time.monotonic() + timeout
    try:
        while True:
            try: p.wait(timeout=0.1); break
            except subprocess.TimeoutExpired: pass
            if cancel is not None and cancel.is_set(): why = "cancel"
            elif time.monotonic() > deadline: why = "timeout"
            if why: stop(); break
    except BaseException:
        stop(); raise
    reader.join(timeout=5)
    if not reader.is_alive(): p.stdout.close()
    text = "\n".join(tail)
    if why == "cancel": raise Cancelled("Cancelled.")
    if why == "timeout" and timeout_is_error: raise BuildError(f"It ran for more than {timeout:g} seconds, so it was stopped.")
    return (None if why else p.returncode), text, why == "timeout"


LINUXDEPLOY_URL = "https://github.com/linuxdeploy/linuxdeploy/releases"


LD_DL = "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-{arch}.AppImage"


LD_HOME = os.path.expanduser("~/.local/bin/linuxdeploy")


def find_linuxdeploy():
    """The linuxdeploy program: on PATH, or the copy Satchel installed in ~/.local/bin (or one in ~/bin). None if none."""
    for n in ("linuxdeploy", f"linuxdeploy-{platform.machine()}.AppImage"):
        found = shutil.which(n)
        if found: return found
    return next((p for p in (LD_HOME, os.path.expanduser("~/bin/linuxdeploy")) if os.access(p, os.X_OK)), None)


def find_linuxdeploy_download():
    """A linuxdeploy file you already downloaded into ~/Downloads (newest first, no plugins), or None."""
    d = os.path.expanduser("~/Downloads")
    try: names = [f for f in os.listdir(d) if f.lower().startswith("linuxdeploy") and "plugin" not in f.lower()]
    except OSError: return None
    files = [f"{d}/{n}" for n in names if os.path.isfile(f"{d}/{n}")]
    files.sort(key=lambda p: (platform.machine() not in os.path.basename(p), -os.path.getmtime(p)))
    return files[0] if files else None


def download_linuxdeploy(dest=None, opener=None):
    """Download linuxdeploy for this machine and install it (~/.local/bin/linuxdeploy). Returns where it went."""
    with tempfile.TemporaryDirectory(prefix="satchel-dl-") as d:
        download(LD_DL.format(arch=platform.machine()), f"{d}/l", opener)
        if appimage_offset(f"{d}/l") is None: raise BuildError("What was downloaded is not an AppImage, so it was not installed.")
        return install_tool(f"{d}/l", dest or LD_HOME)


RUNTIME_URL = "https://github.com/AppImage/type2-runtime/releases"


TOOL_DL = "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-{arch}.AppImage"


RUNTIME_DL = "https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-{arch}"


MAX_DOWNLOAD = 200 * 1024 * 1024


RUNTIME_DIR = os.path.expanduser("~/.local/share/satchel")


TOOL_HOME = os.path.expanduser("~/.local/bin/appimagetool")


def find_tool():
    return os.environ.get("APPIMAGETOOL") or shutil.which("appimagetool") or next(
        (p for p in (TOOL_HOME, os.path.expanduser("~/bin/appimagetool")) if os.access(p, os.X_OK)), None)


def find_download():
    """An appimagetool file you already downloaded into ~/Downloads (newest first), or None."""
    d = os.path.expanduser("~/Downloads")
    try: names = [f for f in os.listdir(d) if f.lower().startswith("appimagetool")]
    except OSError: return None
    files = [f"{d}/{n}" for n in names if os.path.isfile(f"{d}/{n}")]
    files.sort(key=lambda p: (platform.machine() not in os.path.basename(p), -os.path.getmtime(p)))
    return files[0] if files else None


def install_tool(src, dest=TOOL_HOME):
    """Copy a file you downloaded to ~/.local/bin/appimagetool and make it executable. Refuses anything that isn't a program."""
    try:
        with open(src, "rb") as f: magic = f.read(4)
    except OSError as e: raise BuildError(f"Could not read that file: {e}")
    if magic != b"\x7fELF": raise BuildError("That is not a program file (an AppImage starts with ELF). Did the download save a web page?")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".new"
    shutil.copyfile(src, tmp); os.chmod(tmp, 0o755); os.replace(tmp, dest)
    return dest


def download(url, dest, opener=None):
    """Fetch an https address into the file dest (at most MAX_DOWNLOAD bytes). Raises BuildError; leaves no partial file."""
    import urllib.request
    opener = opener or urllib.request.urlopen
    if not url.startswith("https://"): raise BuildError("Only https downloads are allowed.")
    try:
        with opener(urllib.request.Request(url, headers={"User-Agent": "satchel"}), timeout=30) as r, open(dest, "wb") as f:
            if not r.geturl().startswith("https://"): raise BuildError("The download was redirected to an address that is not https.")
            total = 0
            while True:
                chunk = r.read(65536)
                if not chunk: break
                total += len(chunk)
                if total > MAX_DOWNLOAD: raise BuildError("The download is larger than expected, so it was stopped.")
                f.write(chunk)
    except BuildError:
        if os.path.exists(dest): os.unlink(dest)
        raise
    except OSError as e:
        if os.path.exists(dest): os.unlink(dest)
        raise BuildError(f"Could not download {url}\n{e}\nUse 'Use a downloaded file…' instead.")


def download_tool(dest=None, opener=None):
    """Download appimagetool for this machine and install it. Returns where it went."""
    with tempfile.TemporaryDirectory(prefix="satchel-dl-") as d:
        download(TOOL_DL.format(arch=platform.machine()), f"{d}/t", opener)
        if appimage_offset(f"{d}/t") is None: raise BuildError("What was downloaded is not an AppImage, so it was not installed.")
        return install_tool(f"{d}/t", *([dest] if dest else []))


def download_runtime(dest=None, opener=None):
    """Download the AppImage runtime for this machine and install it. Returns where it went."""
    with tempfile.TemporaryDirectory(prefix="satchel-dl-") as d:
        download(RUNTIME_DL.format(arch=platform.machine()), f"{d}/r", opener)
        return install_runtime(f"{d}/r", dest)


def runtime_problem(path):
    """Why path can't be used as the AppImage runtime, or None. A runtime is a small type 2 ELF program; a complete
    AppImage (appimagetool itself, say) also starts with that ELF but has a whole program attached, and using it
    would make every AppImage you build start that program instead of yours."""
    try:
        with open(path, "rb") as f: h = f.read(64)
    except OSError as e: return f"Could not read it: {e}"
    if h[:4] != b"\x7fELF": return "It is not a program file (it should start with ELF). Did the download save a web page?"
    if h[8:11] != b"AI\x02": return "It is not an AppImage runtime (no type 2 marker)."
    if appimage_offset(path) is not None: return "It is a complete AppImage (such as appimagetool itself), not the small runtime file."
    return None


def find_runtime(root=None):
    """The AppImage runtime file, so appimagetool does not have to download it: yours, or one shipped inside the tool."""
    for p in (os.environ.get("APPIMAGE_RUNTIME"), f"{RUNTIME_DIR}/runtime-{platform.machine()}",
              root and f"{root}/usr/lib/appimagekit/runtime"):
        if p and os.path.isfile(p) and not runtime_problem(p): return p
    return None


def find_runtime_download():
    """A runtime-<arch> file you already downloaded into ~/Downloads (newest first), or None."""
    d = os.path.expanduser("~/Downloads")
    try: names = [f for f in os.listdir(d) if f.lower().startswith("runtime") and platform.machine() in f]
    except OSError: return None
    files = [f"{d}/{n}" for n in names if os.path.isfile(f"{d}/{n}") and not runtime_problem(f"{d}/{n}")]
    return max(files, key=os.path.getmtime) if files else None


def install_runtime(src, dest=None):
    """Copy a downloaded runtime file to ~/.local/share/satchel/ after checking it really is a runtime."""
    dest = dest or f"{RUNTIME_DIR}/runtime-{platform.machine()}"
    why = runtime_problem(src)
    if why: raise BuildError(why)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.copyfile(src, dest + ".new"); os.chmod(dest + ".new", 0o644); os.replace(dest + ".new", dest)
    return dest


CACHE = os.path.expanduser("~/.cache/satchel")


def prepare_tool(tool):
    """(program to run, folder it needs or None). An AppImage tool is unpacked once and run as an ordinary program: with
    'ajail on' every AppImage is started inside a second sandbox that cannot see the build folder."""
    real = os.path.realpath(tool)
    off = appimage_offset(real)
    if off is None: return real, None
    st = os.stat(real)
    base = f"{CACHE}/{clean(os.path.basename(real))}-{st.st_size}-{st.st_mtime_ns}"
    root = f"{base}/root"
    if not os.path.isfile(f"{root}/AppRun"):
        unsq = shutil.which("unsquashfs")
        if not unsq: raise BuildError(f"unsquashfs is needed to unpack appimagetool: {install_hint('squashfs-tools')}")
        shutil.rmtree(base, ignore_errors=True)
        os.makedirs(base, mode=0o700)
        tmp = f"{base}/root.tmp"
        try: r = subprocess.run([unsq, "-no-progress", "-no-xattrs", "-o", str(off), "-d", tmp, real], capture_output=True,
                                text=True, errors="replace", stdin=subprocess.DEVNULL, timeout=300)
        except (OSError, subprocess.TimeoutExpired) as e: raise BuildError(f"Could not unpack appimagetool: {e}")
        if r.returncode != 0 or not os.path.isfile(f"{tmp}/AppRun"):
            shutil.rmtree(base, ignore_errors=True)
            raise BuildError("Could not unpack appimagetool:\n" + (r.stderr or r.stdout).strip()[-600:])
        subprocess.run(["chmod", "-R", "u+rwX", tmp], check=False)
        os.replace(tmp, root)
    return f"{root}/AppRun", root


def bundle_libraries(appdir, ident, exe, log=None, cancel=None, bwrap=None):
    """Run linuxdeploy on the AppDir so the libraries the program needs are copied into appdir/usr/lib. With bwrap it runs
    inside bubblewrap: no network, your home hidden, only the folder holding the AppDir writable."""
    tool = find_linuxdeploy()
    if not tool: raise BuildError(f"Bundling libraries needs linuxdeploy, which was not found. Download it from "
                                  f"{LINUXDEPLOY_URL}, make it executable and put it in your PATH.")
    if log: log("Copying libraries in (linuxdeploy)…")
    prog = f"{appdir}/usr/lib/{ident}/{os.path.normpath(exe)}"
    cmd, env, work = [tool, "--appdir", appdir, "--executable", prog], {**os.environ, "APPIMAGE_EXTRACT_AND_RUN": "1"}, os.path.dirname(appdir)
    if bwrap:
        base = bwrap_base(bwrap, (tool,), work, platform.machine(), os.path.realpath(os.path.expanduser("~")), False)
        cmd = base[:-3] + ["--setenv", "APPIMAGE_EXTRACT_AND_RUN", "1"] + base[-3:] + [os.path.realpath(tool), *cmd[1:]]
    code, text, _ = run_streaming(cmd, env, work, log, cancel, 600, own_group=not bwrap)
    if code != 0: raise BuildError("linuxdeploy failed:\n" + text.strip()[-900:])


def placeholder_icon(dst):
    """A plain 256x256 PNG square (appimagetool wants a PNG for .DirIcon)."""
    n, bg, fg = 256, bytes((0x3B, 0x42, 0x52, 255)), bytes((0xEC, 0xEF, 0xF4, 255))
    row = lambda y: b"\0" + b"".join(fg if 96 <= x < 160 and 96 <= y < 160 else bg for x in range(n))
    def chunk(t, d): return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", n, n, 8, 6, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(b"".join(row(y) for y in range(n)))) + chunk(b"IEND", b""))
    with open(dst, "wb") as f: f.write(png)


def check_inputs(src, name, exe, icon, category, version="", comment=""):
    """Check what the person gave. Returns (name, version, comment, clean name, program inside the folder, icon extension);
    raises BuildError with a plain message when something is wrong."""
    name, version, comment = name.strip(), version.strip(), comment.strip()
    if not name or any(ord(c) < 32 for c in name): raise BuildError("Give the app a name (one line, no control characters).")
    if any(ord(c) < 32 for c in version): raise BuildError("The version must be one line, no control characters.")
    if any(ord(c) < 32 for c in comment): raise BuildError("The description must be one line, no control characters.")
    if category not in CATEGORIES: raise BuildError(f"Unknown category '{category}'.")
    src = os.path.realpath(src)
    if os.path.isdir(src):
        exe = os.path.normpath(exe or "")
        if not exe or exe == "." or os.path.isabs(exe) or exe.split(os.sep)[0] == "..": raise BuildError("Choose which program in the folder to start.")
        if not os.path.isfile(os.path.join(src, exe)): raise BuildError(f"'{exe}' is not an executable file inside the folder.")
        real_exe = os.path.realpath(os.path.join(src, exe))
        if outside_link(os.path.join(src, exe), src) or not real_exe.startswith(src + os.sep):
            raise BuildError(f"'{exe}' is a symbolic link that leads outside the folder, so it would not be packed. Copy the real file into the folder.")
        if not is_program(os.path.join(src, exe)):
            raise BuildError(f"'{exe}' is not an executable file (it is not a binary or a script that starts with #!).")
    elif os.path.isfile(src):
        if not is_program(src): raise BuildError("That file is not an executable program (it is not a binary or a script that starts with #!).")
        exe = os.path.basename(src)
    else:
        raise BuildError("Choose the program file or folder to pack.")
    why = nested_problem(os.path.join(src, exe) if os.path.isdir(src) else src)
    if why: raise BuildError(why)
    if icon:
        ext = os.path.splitext(icon)[1].lower()
        if icon_problem(icon): raise BuildError(icon_problem(icon))
    else:
        ext = ".png"
    return name, version, comment, clean(name), exe, ext


def desktop_file(ident, name, category, terminal, version="", comment=""):
    """The text of the .desktop file."""
    return (f"[Desktop Entry]\nType=Application\nName={desktop_text(name)}\n"
            + (f"Comment={desktop_text(comment)}\n" if comment else "")
            + f"Exec={ident}\nIcon={ident}\nCategories={category};\nTerminal={'true' if terminal else 'false'}\n"
            + (f"X-AppImage-Version={desktop_text(version)}\n" if version else ""))


def usr_layout(src, exe):
    """True when src is an unpacked package: a usr/ tree with share/ in it and a program under usr/ or opt/."""
    return (os.path.isdir(os.path.join(src, "usr", "share"))
            and os.path.normpath(exe or "").replace(os.sep, "/").startswith(("usr/", "opt/")))


def apprun_script(ident, exe, libs, usr=False, bundled=False):
    """The text of AppRun: it starts the program, with LD_LIBRARY_PATH pointing at the .so folders packed next to it.
    usr (an unpacked package) also puts the package's usr/bin and usr/share on PATH and XDG_DATA_DIRS; bundled adds
    the folder linuxdeploy copied libraries into."""
    out = '#!/bin/sh\nHERE="$(dirname "$(readlink -f "$0")")"\n'
    if libs or usr or bundled: out += f'APP="$HERE"/{shlex.quote(f"usr/lib/{ident}")}\n'
    parts = [('"$APP"' if r == "." else '"$APP"/' + shlex.quote(r)) for r in libs] + (['"$HERE"/usr/lib'] if bundled else [])
    if parts:                                       # let the program find the .so files packed next to it
        out += f'LD_LIBRARY_PATH={":".join(parts)}"${{LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}}"; export LD_LIBRARY_PATH\n'
    if usr:
        out += ('PATH="$APP"/usr/bin:"$APP"/usr/games"${PATH:+:$PATH}"; export PATH\n'
                'XDG_DATA_DIRS="$APP"/usr/share:"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"; export XDG_DATA_DIRS\n')
    return out + f'exec "$HERE"/{shlex.quote(f"usr/lib/{ident}/{exe}")} "$@"\n'


def app_libs(src, exe):
    """The .so folders to put on LD_LIBRARY_PATH (a package is searched deeper)."""
    return library_dirs(src, 5 if usr_layout(src, exe) else 3) if os.path.isdir(src) else []


def preview(src, name, exe, icon, category, terminal, version="", comment="", bundle=False):
    """(clean name, .desktop text, AppRun text) exactly as a build would write them, with the same checks and without
    copying anything."""
    name, version, comment, ident, exe, _ext = check_inputs(src, name, exe, icon, category, version, comment)
    real = os.path.realpath(src)
    return (ident, desktop_file(ident, name, category, terminal, version, comment),
            apprun_script(ident, exe, app_libs(real, exe), usr_layout(real, exe), bundle))


def make_appdir(src, name, exe, icon, category, terminal, appdir, version="", comment="", bundle=False, log=None, cancel=None, bwrap=None):
    """Lay out an AppDir in appdir (must not exist). src is a file or a folder; exe is the program to start,
    relative to the folder (ignored for a single file). With bundle, linuxdeploy copies the libraries the program needs into
    the AppDir. Returns the clean name used for files."""
    name, version, comment, ident, exe, ext = check_inputs(src, name, exe, icon, category, version, comment)
    src = os.path.realpath(src)
    lib = f"{appdir}/usr/lib/{ident}"
    os.makedirs(lib)
    if os.path.isdir(src):
        shutil.copytree(src, lib, symlinks=True, dirs_exist_ok=True,
                        ignore=lambda d, names: [n for n in names if outside_link(os.path.join(d, n), src)])
    else: shutil.copy2(src, f"{lib}/{exe}")
    prog = os.path.join(lib, exe)                   # the packed copy must be startable even if the original lost its bit
    os.chmod(prog, (os.stat(prog).st_mode & 0o7777) | 0o111)
    if icon: shutil.copy2(icon, f"{appdir}/{ident}{ext}")
    else: placeholder_icon(f"{appdir}/{ident}{ext}")
    shutil.copy2(f"{appdir}/{ident}{ext}", f"{appdir}/.DirIcon")
    with open(f"{appdir}/{ident}.desktop", "w") as f: f.write(desktop_file(ident, name, category, terminal, version, comment))
    if bundle: bundle_libraries(appdir, ident, exe, log, cancel, bwrap)
    with open(f"{appdir}/AppRun", "w") as f: f.write(apprun_script(ident, exe, app_libs(src, exe), usr_layout(src, exe), bundle))
    os.chmod(f"{appdir}/AppRun", 0o755)
    return ident


def build(src, name, exe, icon, category, terminal, out_dir, tool=None, sandbox=False, version="", log=None, cancel=None, comment="", bundle=False):
    """Make the AppDir in a temporary folder, run appimagetool on it (optionally inside bubblewrap), and move the
    result to out_dir. Returns the path of the .AppImage. A version goes into the desktop file, the file name and
    the VERSION variable that appimagetool reads; a comment goes into the desktop file. log(line) is called with the tool's output while it runs; setting
    the cancel event stops the build (raises Cancelled)."""
    version = version.strip()
    tool = tool or find_tool()
    if not tool: raise BuildError(f"appimagetool was not found. Download it from {TOOL_URL}, make it executable and put it in your PATH.")
    if not os.path.isdir(out_dir): raise BuildError("The output folder does not exist.")
    bwrap = need_bwrap() if sandbox else None
    if cancel is not None and cancel.is_set(): raise Cancelled("Cancelled.")
    prog, share = prepare_tool(tool)
    runtime = find_runtime(share)
    with tempfile.TemporaryDirectory(prefix="satchel-") as tmp:
        tmp = os.path.realpath(tmp)
        appdir = f"{tmp}/AppDir"
        if log: log("Making the app folder…")
        ident = make_appdir(src, name, exe, icon, category, terminal, appdir, version, comment, bundle, log, cancel, bwrap)
        arch = platform.machine()
        stem = f"{ident}-{clean(version)}-{arch}" if version else f"{ident}-{arch}"
        built = f"{tmp}/{stem}.AppImage"
        if bwrap: cmd, env = bwrap_cmd(bwrap, prog, share, runtime, appdir, built, tmp, arch, os.path.realpath(os.path.expanduser("~")), not runtime, version), os.environ
        else: cmd, env = [prog, *(["--runtime-file", runtime] if runtime else []), appdir, built], {**os.environ, "ARCH": arch, **({"VERSION": version} if version else {})}
        code, text, _ = run_streaming(cmd, env, tmp, log, cancel, 600, own_group=not bwrap)
        if code != 0 or not os.path.isfile(built):
            hint = "\n\n(If the sandbox is the problem, switch it off and try again.)" if bwrap else ""
            raise BuildError("appimagetool failed:\n" + text.strip()[-900:] + hint)
        if appimage_offset(built) is None:
            raise BuildError("appimagetool finished, but the file it made is not a valid AppImage "
                             "(no squashfs image after the runtime), so it was not saved.\n" + text.strip()[-600:])
        out = f"{out_dir}/{stem}.AppImage"
        shutil.move(built, out)
    return out


def describe_run(code, text, timed_out, seconds, sandboxed):
    """Plain words for how a test run went: what happened, a hint for the usual causes, then the end of its output."""
    if timed_out: head = f"It was still running after {seconds:g} seconds, so it starts. It was stopped again."
    elif code == 0: head = "It started and finished normally."
    else: head = f"It stopped by itself with exit code {code}."
    low, lines = text.lower(), [head]
    if "shared librar" in low or "shared object file" in low:
        lines.append("A shared library is missing. Install it, or pack it in the folder.")
    if "exec format error" in low:
        lines.append("The program is not for this kind of computer, or it is not a real program (exec format error).")
    if code in (126, 127):
        lines.append("The program could not be started at all: check that the right file is chosen and that it is executable.")
    if sandboxed and not timed_out and code != 0 and any(w in low for w in ("display", "wayland", "xcb", "x server")):
        lines.append("It looks like a window program, but it could not reach a screen from inside the sandbox "
                     "(the screen is shared when one is found). Switch the sandbox off to see it.")
    if sandboxed: lines.append("(It ran inside the sandbox: no network, your home folder hidden.)")
    tail = text.strip()[-700:]
    return "\n".join(lines) + (f"\n\nOutput:\n{tail}" if tail else "")


def try_run(src, name, exe, icon, category, terminal, sandbox=False, seconds=5, log=None, cancel=None, bundle=False):
    """Start the packed program the way the AppImage would and watch it for a few seconds (inside bubblewrap, with no
    network and your home hidden but your screen shared, when sandbox is on). Returns (ok, a description); ok means it ran fine or was still
    running when the time was up. It catches a wrong program, a missing library or a format error before you build."""
    bwrap = need_bwrap() if sandbox else None
    with tempfile.TemporaryDirectory(prefix="satchel-try-") as tmp:
        tmp = os.path.realpath(tmp)
        appdir = f"{tmp}/AppDir"
        make_appdir(src, name, exe, icon, category, terminal, appdir, "", "", bundle, log, cancel, bwrap)   # the same checks as a build
        cmd = [f"{appdir}/AppRun"]
        if bwrap: cmd = bwrap_base(bwrap, (), tmp, platform.machine(), os.path.realpath(os.path.expanduser("~")), False, display=True) + cmd
        code, text, timed_out = run_streaming(cmd, os.environ, tmp, log, cancel, seconds, False, own_group=not bwrap)
    return (timed_out or code == 0), describe_run(code, text, timed_out, seconds, bool(bwrap))


def cli(argv):
    """Build from the command line, no window. Prints the path of the AppImage; returns the exit code."""
    import argparse
    p = argparse.ArgumentParser(prog="satchel", description="Build an AppImage from a program file or folder (no window).")
    p.add_argument("source", help="the program file, the folder that holds the program, or a .deb package, .tar.* archive or .zip file")
    p.add_argument("--name", help="app name (default: the file or folder name)")
    p.add_argument("--exe", default="", help="for a folder: the program to start, relative to the folder")
    p.add_argument("--icon", help="a .png or .svg file (default: the best one found inside the folder)")
    p.add_argument("--category", choices=CATEGORIES, help="default: from the package, else Utility")
    p.add_argument("--version", default="", help="goes into the file name and the desktop file")
    p.add_argument("--comment", default="", help="a short description for the desktop file")
    p.add_argument("--terminal", action="store_true", help="the app runs in a terminal")
    p.add_argument("--bundle-libs", action="store_true", help="copy the libraries the program needs into the AppImage (needs linuxdeploy)")
    p.add_argument("--out", default=".", help="folder for the result (default: here)")
    p.add_argument("--sandbox", action="store_true", help="run appimagetool (or the test run) inside bubblewrap")
    p.add_argument("--try", dest="try_first", action="store_true",
                   help="only start the program for a few seconds to see that it works; builds nothing")
    p.add_argument("--seconds", type=float, default=5, help="with --try: how long to watch the program (default 5)")
    p.add_argument("--dry-run", action="store_true", help="only print the .desktop file and AppRun that would be made; builds nothing")
    p.add_argument("-v", "--verbose", action="store_true", help="show the output while it runs")
    a = p.parse_args(argv)
    if not is_package(a.source):
        a.category = a.category or "Utility"
        return cli_run(a)
    with tempfile.TemporaryDirectory(prefix="satchel-pkg-") as t:
        root = f"{t}/root"
        try: root = unpack_package(a.source, root)
        except BuildError as e:
            print(e, file=sys.stderr)
            return 1
        hint = package_hint(a.source)
        info = package_info(root, hint)
        if not (a.exe or info["exe"]):
            print("No program was found inside that file.", file=sys.stderr)
            return 1
        a.name, a.exe = a.name or info["name"] or hint, a.exe or info["exe"]
        a.icon, a.comment = a.icon or info["icon"], a.comment or info["comment"]
        a.category, a.terminal = a.category or info["category"] or "Utility", a.terminal or info["terminal"]
        print(f"From the package or archive: program {a.exe}, name {a.name}" + (f", icon {os.path.relpath(a.icon, root)}" if a.icon else ""),
              file=sys.stderr)
        if (a.try_first or a.bundle_libs) and not a.dry_run and not a.sandbox:
            print("Heads up: --try and --bundle-libs run programs from this package on your computer without the sandbox. "
                  "Add --sandbox unless you trust it.", file=sys.stderr)
        a.source = root
        return cli_run(a)


def cli_run(a):
    name = a.name or default_name(os.path.realpath(a.source))
    log = (lambda line: print(line, file=sys.stderr)) if a.verbose else None
    note = packing_notes(a.source, a.exe, a.bundle_libs)
    if not a.icon and os.path.isdir(a.source):
        a.icon = find_icon(a.source, (os.path.basename(os.path.realpath(a.source)), os.path.basename(a.exe)))
        if a.icon: print(f"Icon found in the folder: {a.icon}", file=sys.stderr)
    try:
        if a.dry_run:
            ident, desktop, apprun = preview(a.source, name, a.exe, a.icon, a.category, a.terminal, a.version, a.comment, a.bundle_libs)
            print(f"--- {ident}.desktop ---\n{desktop}\n--- AppRun ---\n{apprun}", end="")
            if note: print(note, file=sys.stderr)
            return 0
        if a.try_first:
            ok, text = try_run(a.source, name, a.exe, a.icon, a.category, a.terminal, a.sandbox, a.seconds, log, None, a.bundle_libs)
            print(text)
            if note: print(note, file=sys.stderr)
            return 0 if ok else 1
        print(build(a.source, name, a.exe, a.icon, a.category, a.terminal, os.path.abspath(a.out), None, a.sandbox, a.version, log, None, a.comment, a.bundle_libs))
    except BuildError as e:
        print(e, file=sys.stderr)
        return 1
    if note: print(note, file=sys.stderr)
    return 0


SETTINGS = os.path.expanduser("~/.config/satchel/settings.json")


def load_settings(path=None):
    """The choices saved from the last run. Each value is checked; anything missing or wrong is left out."""
    try:
        with open(path or SETTINGS) as f: raw = json.load(f)
    except (OSError, ValueError): return {}
    if not isinstance(raw, dict): return {}
    out = {}
    if isinstance(raw.get("out_dir"), str) and os.path.isdir(raw["out_dir"]): out["out_dir"] = raw["out_dir"]
    if isinstance(raw.get("last_dir"), str) and os.path.isdir(raw["last_dir"]): out["last_dir"] = raw["last_dir"]
    if raw.get("category") in CATEGORIES: out["category"] = raw["category"]
    for k in ("terminal", "sandbox"):
        if isinstance(raw.get(k), bool): out[k] = raw[k]
    return out


def save_settings(data, path=None):
    """Remember the choices. This is a convenience, so a failure to write is ignored and never stops a build."""
    path = path or SETTINGS
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".new", "w") as f: json.dump(data, f, indent=1)
        os.replace(path + ".new", path)
    except OSError: pass


